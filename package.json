{
  "name": "who-decides",
  "version": "0.1.0",
  "description": "A Strands agent that works in the background and surfaces only when there's a real human decision",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/console/server.ts",
    "smoke": "tsx src/smoke.ts",
    "preflight": "tsx src/preflight.ts",
    "spike:interrupt": "tsx src/spike-interrupt.ts",
    "gate:bedrock": "tsx src/gate-bedrock.ts",
    "live-loop": "tsx src/live-loop.ts",
    "test:consumption": "tsx --test src/consumption/test.ts",
    "test:console": "tsx --test src/server/test.ts",
    "scenario": "tsx src/scenario/run.ts",
    "test:artifacts": "tsx --test src/artifacts/test.ts",
    "console": "next dev -p 3100",
    "console:build": "next build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joefeser/who-decides.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/joefeser/who-decides/issues"
  },
  "homepage": "https://github.com/joefeser/who-decides#readme",
  "private": "true",
  "dependencies": {
    "@strands-agents/sdk": "^1.16.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.4",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
