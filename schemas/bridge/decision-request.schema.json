{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://who-decides.example/schemas/bridge/decision-request.v0.json",
  "title": "External decision request envelope (bridge intake)",
  "description": "What an external system (the chopin bridge) may ask who-decides to hold for a human decision. Strict by design: additionalProperties is false everywhere, and there is deliberately NO actor/identity field — the actor is sourced at decision time from the operator session channel, never from anything the caller sent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceSystem",
    "question",
    "options",
    "contextRefs",
    "digests"
  ],
  "properties": {
    "schema": {
      "const": "who-decides.decision-request.v0"
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "contextRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/digest"
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "What the digest covers, in the source system's vocabulary (e.g. 'draft-graph@v3')."
        }
      }
    }
  }
}
