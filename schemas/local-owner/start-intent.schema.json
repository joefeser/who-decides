{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://who-decides.example/schemas/start-intent.0.1-candidate.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKind",
    "profileId",
    "profileVersion",
    "issuerId",
    "decisionId",
    "digest",
    "claimDigest",
    "intentId",
    "successorId",
    "action",
    "admittedAt",
    "decisionStatusHead",
    "claimStatusHead",
    "clockSample",
    "expiryDeadlineMonotonicNanoseconds"
  ],
  "properties": {
    "recordKind": {
      "const": "start-intent"
    },
    "profileId": {
      "const": "org.hacp.local-owner-continuation"
    },
    "profileVersion": {
      "const": "0.1-candidate"
    },
    "issuerId": {
      "type": "string",
      "minLength": 1
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "$ref": "#/$defs/digest",
      "properties": {
        "domain": {
          "const": "org.hacp.local-owner-continuation.start-intent.0.1-candidate"
        }
      }
    },
    "claimDigest": {
      "$ref": "#/$defs/digest",
      "properties": {
        "domain": {
          "const": "org.hacp.local-owner-continuation.claim.0.1-candidate"
        }
      }
    },
    "intentId": {
      "type": "string"
    },
    "successorId": {
      "type": "string"
    },
    "action": {
      "const": {
        "operationId": "observe_fixed_payload",
        "parameters": {
          "payload": "HACP_LOCAL_OWNER_CONTINUATION_PROBE_V1"
        }
      }
    },
    "admittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "decisionStatusHead": {
      "type": "string"
    },
    "claimStatusHead": {
      "type": "string"
    },
    "clockSample": {
      "$ref": "#/$defs/clock"
    },
    "expiryDeadlineMonotonicNanoseconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "domain",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "json-rfc8785-jcs"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallTime",
        "monotonicNanoseconds"
      ],
      "properties": {
        "wallTime": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
        },
        "monotonicNanoseconds": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
