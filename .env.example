# who-decides provider configuration (RULING M4).
# Copy to .env (gitignored) and fill in. There is no settings UI.

# Escape hatch (tested fallback). Bring any OpenAI-compatible key.
# Note: a free tier that expires is a build-time budget, never the
# documented default — see docs/spike-log.md.
WD_PROVIDER=openai-compatible
WD_BASE_URL=https://api.openai.com/v1
WD_MODEL=gpt-4o
WD_API_KEY=sk-...

# Bedrock is the documented default (gate COMMIT 2026-09-03): pin via WD_BEDROCK_MODEL / WD_AWS_REGION;
# credentials come from the AWS default chain (e.g. AWS_PROFILE=who-decides).
# come from the default credential chain (env/profile), never from here.

# Operator passcode gate (public demo): all mutation routes require a valid
# operator session. Store ONLY the sha256 hex of the passcode — never the
# passcode itself. Missing/malformed hash fails closed (console stays
# read-only for everyone).
#   printf '%s' 'choose-a-long-passcode' | sha256sum       # Linux
#   printf '%s' 'choose-a-long-passcode' | shasum -a 256   # macOS
WD_OPERATOR_PASSCODE_HASH=<64-hex sha256 of the operator passcode>

# Agent service machine token (AC-2): the AgentCore runtime authenticates
# with this scoped service token. Generate: echo -n "$TOKEN" | shasum -a 256
# Absent = the agent service refuses all invocations (fail closed).
# WD_MACHINE_TOKEN_HASH=<64-hex sha256 of the service token>

# Agent dispatch (AC-3): the console proxies agent invocations to the deployed
# AgentCore runtime. Both must be set to enable dispatch; absent = the console
# runs its deterministic engine and routes report agent: undefined.
# WD_AGENTCORE_ENDPOINT=<the runtime ARN or endpoint>
# WD_MACHINE_TOKEN=<the agent runtime's service token>
