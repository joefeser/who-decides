{
  "name": "whoDecides",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "who_decides_agent",
      "description": "who-decides HTTP agent; Linux ARM64 Node 22 container preserves native SQLite. Deployment remains manual.",
      "build": "Container",
      "entrypoint": "main.js",
      "codeLocation": "agentcore/app/who-decides-agent",
      "runtimeVersion": "NODE_22",
      "protocol": "HTTP",
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "envVars": [
        {
          "name": "WD_AGENT_PORT",
          "value": "8080"
        },
        {
          "name": "WD_AGENT_DATA_DIR",
          "value": "/mnt/data/agent"
        },
        {
          "name": "WD_PROVIDER",
          "value": "bedrock"
        }
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 600
      },
      "filesystemConfigurations": [
        {
          "sessionStorage": {
            "mountPath": "/mnt/data"
          }
        }
      ],
      "buildContextPath": ".",
      "dockerfile": "Dockerfile"
    }
  ]
}
